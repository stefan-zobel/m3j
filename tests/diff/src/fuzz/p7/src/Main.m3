    P6(1, (MIN(ORD(gr.c), (gs + ORD(gp.c)))) MOD 997, (NUMBER(ga)) MOD 997, gr2.arr, SUBARRAY(ga, (MIN(NUMBER(gr2.arr), gp.x)) MOD NUMBER(ga), 1 + ((gi1 + gi1)) MOD (NUMBER(ga) - (MIN(NUMBER(gr2.arr), gp.x)) MOD NUMBER(ga))));
  EXCEPT
  | E =>
    T("t266", 0);
  | F (e265) =>
    T("t267", e265);
  END;
  Snap("t273");
  TRY
    T("t269", P9(((MAX(255, 100) DIV 8)) MOD 997, gr.arr[((ORD(gp.c) DIV 4)) MOD 3], go[((100 DIV 5)) MOD NUMBER(go^)], gr));
  EXCEPT
  | E =>
    T("t271", 0);
  | F (e270) =>
    T("t272", e270);
  END;
  TRY
    T("t274", P9((gs) MOD 997, gi0, gr2.a, gr));
  EXCEPT
  | E =>
    T("t276", 0);
  | F (e275) =>
    T("t277", e275);
  END;
  Snap("end");
END Main.
