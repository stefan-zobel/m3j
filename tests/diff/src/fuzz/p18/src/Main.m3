  go2 := NEW(REF ARRAY OF ARRAY OF INTEGER, 2, 3);
  go2[0, 0] := (-100);
  go2[0, 1] := 3;
  go2[0, 2] := 3;
  go2[1, 0] := 0;
  go2[1, 1] := 219;
  go2[1, 2] := 255;
  m := NEW(MUTEX);
  fuel := 300;
  gob := NEW(O, a := 19);
  gob1 := NEW(O1, a := 16, b := 7, m := O1m);
  gob2 := NEW(O2, b := (-3));
  gob3 := NEW(O3);
  goa[0] := gob3;
  goa[1] := gob;
  goa[2] := gob3;
  gl := NIL;
  gl := NEW(L, v := (-2), next := gl);
  gl := NEW(L, v := 7, next := gl);
  gl := NEW(L, v := 3, next := gl);
  gri := NEW(REF INTEGER);
  gri^ := (-7);
  grr := NEW(REF Rec);
  grr^ := gr;
  gany := gri;
  gcs := CS{Color.Green, Color.Gray};
  gss := SS{11, 20, 17, 18};
  gsa[0] := SS{7};
  gsa[1] := SS{};
  gsa[2] := SS{};
  gbs := BS{27 .. 28, 47};
  gchs := CHS{'a' .. 'c', 'x', VAL(242, CHAR)};
  gt := "Hello";
  gt2 := "Hello";
  gch := 'b';
  gca := Chars{'z', 'x', 'x', '0', 'z', '0'};
  Snap("init");
  FOR round := 1 TO 3 DO
    fuel := 300;
    T("round", round);
    gi0 := (gi0 + round * 24) MOD 997;
    gi1 := (gi1 + round * 30) MOD 997;
    gi2 := (gi2 + round * 4) MOD 997;
    gi3 := (gi3 + round * 45) MOD 997;
    gs := (gs + round * 6) MOD 26 - 5;
    gc := VAL((ORD(gc) + round) MOD 4, Color);
    CASE round MOD 3 OF 0 => gany := gob | 1 => gany := gob1 | 2 => gany := gri ELSE END;
    goa[round MOD 3] := goa[(round + 1) MOD 3];
    gt := Text.Sub(gt & Fmt.Int(round * 2), 0, 16);
    gch := VAL(ORD('a') + (ORD(gch) + round * 3) MOD 26, CHAR);
    gss := gss / SS{round, round * 3};
    gbs := gbs + BS{round * 5 .. round * 21};
    TRY
      P0(gt);
    EXCEPT
    | E =>
      T("t388", 0);
    | F (e387) =>
      T("t389", e387);
    END;
    TRY
      P0(Fmt.Int((gi1 DIV 7)));
    EXCEPT
    | E =>
      T("t391", 0);
    | F (e390) =>
      T("t392", e390);
    END;
    TRY
      T("t393", O1k(NEW(O1), (gi1) MOD 997).a);
    EXCEPT
    | E =>
      T("t395", 0);
    | F (e394) =>
      T("t396", e394);
    END;
    TRY
      T("t397", O1m(gob2, (ORD(gob1.c)) MOD 997));
    EXCEPT
    | E =>
      T("t399", 0);
    | F (e398) =>
      T("t400", e398);
    END;
    TRY
      T("t401", O3m(gob3, (ABS((gp.z * (-1)))) MOD 997));
    EXCEPT
    | E =>
      T("t403", 0);
    | F (e402) =>
      T("t404", e402);
    END;
    TRY
      PT("t405", P13(2, Fmt.Int((ORD(gr2.c) - (-100))), gob2, ga));
    EXCEPT
    | E =>
      T("t407", 0);
    | F (e406) =>
      T("t408", e406);
    END;
    Snap("t413");
    TRY
      PT("t409", P13(1, gt2, gob2, ga));
    EXCEPT
    | E =>
      T("t411", 0);
    | F (e410) =>
      T("t412", e410);
    END;
    TRY
      T("t414", ORD(3 IN P14(CHS{}, gt2, gob1, gob3.s)));
    EXCEPT
    | E =>
      T("t416", 0);
    | F (e415) =>
      T("t417", e415);
    END;
    TRY
      T("t418", P16(gbs, gob3.s, NEW(O3, s := (gp.s / CS{VAL(((gr.b - gob.a)) MOD 4, Color), VAL(((gi2 MOD 6)) MOD 4, Color), VAL(((gs + gp.y)) MOD 4, Color)})), gsa[((gs + gi0)) MOD 3])[3]);
    EXCEPT
    | E =>
      T("t420", 0);
    | F (e419) =>
      T("t421", e419);
    END;
    TRY
      T("t422", P16(BS{}, CS{VAL(((((-2) - go[((ORD(VAL((gi3) MOD 4, Color) IN gcs) DIV 6)) MOD NUMBER(go^)]) - (gp.x + ORD((NUMBER(gr2.arr)) MOD 100 IN gbs)))) MOD 4, Color), VAL((grr^.b) MOD 4, Color), VAL((2) MOD 4, Color)}, NEW(O2, nx := gob1), gss)[1]);
    EXCEPT
    | E =>
      T("t424", 0);
    | F (e423) =>
      T("t425", e423);
    END;
    TRY
      goa[((gr.a + ORD(gr2.c))) MOD 3].n(gi1, gr2);
    EXCEPT
    | E =>
      T("t427", 0);
    | F (e426) =>
      T("t428", e426);
    END;
  END;
  Snap("end");
END Main.
