  gsa[1] := SS{1, 4};
  gsa[2] := SS{6};
  gbs := BS{15 .. 49, 21};
  gchs := CHS{'a' .. 'c', 'y', VAL(57, CHAR)};
  gt := "a";
  gt2 := "ab";
  gch := 'b';
  gca := Chars{'c', 'z', 'x', 'c', 'x', 'b'};
  Snap("init");
  FOR round := 1 TO 3 DO
    fuel := 300;
    T("round", round);
    gi0 := (gi0 + round * 38) MOD 997;
    gi1 := (gi1 + round * 29) MOD 997;
    gi2 := (gi2 + round * 40) MOD 997;
    gi3 := (gi3 + round * 50) MOD 997;
    gs := (gs + round * 6) MOD 26 - 5;
    gc := VAL((ORD(gc) + round) MOD 4, Color);
    CASE round MOD 3 OF 0 => gany := gl | 1 => gany := gob3 | 2 => gany := grr ELSE END;
    gt := Text.Sub(gt & Fmt.Int(round * 4), 1, 16);
    gch := VAL(ORD('a') + (ORD(gch) + round * 3) MOD 26, CHAR);
    gss := gss / SS{round, round * 6};
    gbs := gbs + BS{round * 27 .. round * 26};
    IF round = 2 THEN gqa[1] := NEW(QT3, a := gi0, v := gi1) END;
    TRY
      T("t376", O1m(gob1, (ABS((ORD(grr.c) + 161))) MOD 997));
    EXCEPT
    | E =>
      T("t378", 0);
    | F (e377) =>
      T("t379", e377);
    END;
    TRY
      T("t380", O3m(gob3, (4) MOD 997));
    EXCEPT
    | E =>
      T("t382", 0);
    | F (e381) =>
      T("t383", e381);
    END;
    TRY
      O2n(NEW(O2, a := (10) MOD 997, r := r2, b := (((10 * 0) * (-3))) MOD 26 - 5), x1, grr^);
    EXCEPT
    | E =>
      T("t385", 0);
    | F (e384) =>
      T("t386", e384);
    END;
    TRY
      O3n(gob3, gob1.a, grr^);
    EXCEPT
    | E =>
      T("t388", 0);
    | F (e387) =>
      T("t389", e387);
    END;
    TRY
      On(gob1, gri^, gob2.r);
    EXCEPT
    | E =>
      T("t391", 0);
    | F (e390) =>
      T("t392", e390);
    END;
    TRY
      T("t393", P19((gi1) MOD 997));
    EXCEPT
    | E =>
      T("t395", 0);
    | F (e394) =>
      T("t396", e394);
    END;
    Snap("t401");
    TRY
      T("t397", ORD(7 IN P22(gob2, ga)));
    EXCEPT
    | E =>
      T("t399", 0);
    | F (e398) =>
      T("t400", e398);
    END;
    TRY
      T("t402", P23(((3 + gob1.r.a)) MOD 997));
    EXCEPT
    | E =>
      T("t404", 0);
    | F (e403) =>
      T("t405", e403);
    END;
    TRY
      gi2 := O2.m(gob2, (((ORD(r2.c) DIV 7) + MAX(100, 2))) MOD 997);
    EXCEPT
    | E =>
      T("t407", 0);
    | F (e406) =>
      T("t408", e406);
    END;
  END;
  Snap("end");
END Main.
