            T("t273", (i271 MOD 997));
            T("t272", 66);
            IF ((gs + 10)) MOD 3 = 0 THEN EXIT END;
            RETURN ga;
          END;
          gr.c := VAL((MIN(gr2.b, 101)) MOD 4, Color);
          RAISE F((MAX(ORD(v31), 93)) MOD 997);
          IF (v30[((NUMBER(v28) * (-2))) MOD 5] DIV 2) <= gr.b THEN RAISE E END;
        EXCEPT
        ELSE
          T("t274", 0);
          CASE ((MAX(gp.z, 1) MOD 1)) MOD 7 OF
          | 3 =>
            T("t275", 0);
          | 0, 1, 2 =>
            T("t276", 0);
          | 4 .. 6 =>
            T("t277", 0);
            v28[((gp.x - 100)) MOD 5] := ((gp.x - 255)) MOD 997;
            T("t278", 100);
          ELSE
            T("t279", 0);
            T("t280", P8(v28[(ABS(gp.x)) MOD 5], v28, gr2, (ORD(gc)) MOD 997));
          END;
        END;
        RETURN v28;
      END;
      INC(gr2.a, 4);
      RETURN v28;
    FINALLY
      Snap("P7>");
    END;
  END P7;

PROCEDURE P9 (d36: INTEGER): Rec RAISES {E, F} =
  BEGIN
    LOCK m DO END;
    DEC(fuel);
    IF fuel < 0 THEN RETURN gr END;
    Snap("P9<");
    T("P9.d36", d36);
    TRY
      gr2.arr := gr2.arr;
      IF ((gr2.arr[((NUMBER(gr2.arr) - gp.x)) MOD 3] - 996)) MOD 3 = 2 THEN RAISE E END;
    EXCEPT
    | E =>
      T("t302", 0);
    | F (e303) =>
      T("t304", e303);
      IF d36 > 0 THEN EVAL P9(d36 - 1) END;
      gp.x := (MAX(d36, gi2)) MOD 32;
    END;
    LOCK m DO
      gp.z := (ORD(gc)) MOD 501;
    END;
    IF NOT (((gi0 - gp.y)) MOD 2 = 1) THEN RETURN gr2 END;
    RETURN gr;
  END P9;

BEGIN
  gi0 := (-2);
  gi1 := (-1);
  gi2 := 4;
  gi3 := 5;
  gs := 8;
  gc := Color.Green;
  ga := Arr5{0, 255, 4, (-1), 5};
  gr := Rec{a := (-100), b := (-3), c := Color.Red, arr := Arr3{5, 7, 1}};
  gr2 := Rec{a := (-100), b := 0, c := Color.Red, arr := Arr3{996, 5, 1}};
  gp := Pk{x := 2, y := (-3), c := Color.Gray, z := 148};
  go := NEW(REF ARRAY OF INTEGER, 3);
  go[0] := (-2);
  go[1] := 255;
  go[2] := (-100);
  go2 := NEW(REF ARRAY OF ARRAY OF INTEGER, 3, 2);
  go2[0, 0] := (-2);
  go2[0, 1] := 4;
  go2[1, 0] := (-2);
  go2[1, 1] := 255;
  go2[2, 0] := (-1);
  go2[2, 1] := (-1);
  m := NEW(MUTEX);
  fuel := 300;
  Snap("init");
  TRY
    T("t305", P0(gr, (ORD(gc)) MOD 26 - 5, (gi0) MOD 997)[0]);
  EXCEPT
  | E =>
    T("t307", 0);
  | F (e306) =>
    T("t308", e306);
  END;
  Snap("t312");
  TRY
    P3((MIN(4, (996 * 5))) MOD 26 - 5);
  EXCEPT
  | E =>
    T("t310", 0);
  | F (e309) =>
    T("t311", e309);
  END;
  TRY
    P3((LAST(ga)) MOD 26 - 5);
  EXCEPT
  | E =>
    T("t314", 0);
  | F (e313) =>
    T("t315", e313);
  END;
  TRY
    T("t316", P7(ga, ga[(gi0) MOD 5], ga)[0]);
  EXCEPT
  | E =>
    T("t318", 0);
  | F (e317) =>
    T("t319", e317);
  END;
  TRY
    T("t320", P9(0).a);
  EXCEPT
  | E =>
    T("t322", 0);
  | F (e321) =>
    T("t323", e321);
  END;
  TRY
    T("t324", P9(2).a);
  EXCEPT
  | E =>
    T("t326", 0);
  | F (e325) =>
    T("t327", e325);
  END;
  Snap("end");
END Main.
