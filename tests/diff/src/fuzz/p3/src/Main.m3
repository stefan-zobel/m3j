            T("t153", go2[((-1)) MOD NUMBER(go2^), ((1 DIV 1)) MOD NUMBER(go2[0])]);
          END;
        END;
      END;
      RETURN ga;
    FINALLY
      Snap("P3>");
    END;
  END P3;

PROCEDURE P4 (x: INTEGER): INTEGER RAISES {E, F} =
  VAR v18: Color := Color.Red;
  VAR v19: Arr5 := ga;
  VAR v20: INTEGER := 0;
  VAR c183: INTEGER := 0;
  BEGIN
    LOCK m DO END;
    DEC(fuel);
    IF fuel < 0 THEN RETURN 0 END;
    Snap("P4<");
    T("P4.x", x);
    TRY
      TRY
        gr.c := VAL((MIN((ORD(gc) - ORD(v18)), 255)) MOD 4, Color);
      FINALLY
        Snap("t163");
        IF (v19[((gp.x DIV 6)) MOD 5]) MOD 3 = 1 THEN RAISE F(((NUMBER(gr2.arr) DIV 7)) MOD 997) END;
        CASE gc OF
        | Color.Green =>
          T("t154", 0);
        | Color.Blue, Color.Gray =>
          T("t155", 0);
          WITH w156 = 1 + ((gp.y * (-3))) MOD MIN(NUMBER(v19), NUMBER(go2[(ABS(5)) MOD NUMBER(go2^)])), w157 = (MIN(gr.a, x)) MOD (NUMBER(v19) - w156 + 1), w158 = ((ORD(gc) * 3)) MOD (NUMBER(go2[(ABS(5)) MOD NUMBER(go2^)]) - w156 + 1) DO
            SUBARRAY(v19, w157, w156) := SUBARRAY(go2[(ABS(5)) MOD NUMBER(go2^)], w158, w156);
          END;
        | Color.Red =>
          T("t159", 0);
          WITH w160 = 1 + ((-2)) MOD MIN(NUMBER(go2[(ORD(gp.c)) MOD NUMBER(go2^)]), NUMBER(go2[(ORD(gp.c)) MOD NUMBER(go2^)])), w161 = ((go2[(ABS(5)) MOD NUMBER(go2^), ((ORD(gp.c) + LAST(v19))) MOD NUMBER(go2[0])] - gi1)) MOD (NUMBER(go2[(ORD(gp.c)) MOD NUMBER(go2^)]) - w160 + 1), w162 = (ABS(ga[((x + gp.y)) MOD 5])) MOD (NUMBER(go2[(ORD(gp.c)) MOD NUMBER(go2^)]) - w160 + 1) DO
            SUBARRAY(go2[(ORD(gp.c)) MOD NUMBER(go2^)], w161, w160) := SUBARRAY(go2[(ORD(gp.c)) MOD NUMBER(go2^)], w162, w160);
          END;
        END;
      END;
      IF (ORD(gr.c)) MOD 2 # 0 THEN
        gp.y := (100) MOD 8 - 4;
        TRY
          v20 := (MIN((gr.a + ORD(gr.c)), ORD(v18))) MOD 997;
          TRY
            T("t164", (221 - 5));
            gi0 := ((996 + gr.a)) MOD 997;
          FINALLY
            Snap("t166");
            T("t165", MIN((gr2.b - 100), gp.z));
          END;
          LOCK m DO
            gr.c := VAL((gr2.b) MOD 4, Color);
          END;
        FINALLY
          T("t167", 0);
          DEC(x);
          IF ((gr2.a DIV 4)) MOD 2 = 0 THEN RAISE E END;
        END;
      END;
      WITH w168 = gr DO
        CASE v18 OF
        | Color.Red .. Color.Blue =>
          T("t169", 0);
          WITH w170 = go2[(NUMBER(go^)) MOD NUMBER(go2^)] DO
            IF ((v19[(((-2) DIV 6)) MOD 5] * 5)) MOD 2 = 1 THEN
              CASE (((LAST(w170) MOD 7) + (10 * 6))) MOD 5 OF
              | 0, 1 =>
                T("t171", 0);
                IF (MIN(gi1, 10)) MOD 4 = 1 THEN RETURN (NUMBER(v19)) MOD 997 END;
                IF (((gr.b + (-100))) MOD 3 = 2) OR (((gr.b + gr2.a)) MOD 4 = 0) THEN RAISE F((3) MOD 997) END;
                RETURN (w168.a) MOD 997;
              ELSE
                T("t172", 0);
              END;
            ELSIF (ORD(w168.c)) MOD 4 = 0 THEN
              FOR i173 := (gr.arr[((gi2 + NUMBER(w168.arr))) MOD 3] - 1) TO (gr.arr[((gi2 + NUMBER(w168.arr))) MOD 3] - 1) + 4 DO
                T("t174", (i173 MOD 997));
                v20 := (w168.a) MOD 997;
                ga := v19;
                RAISE F((((w170[((42 + (-100))) MOD NUMBER(w170)] MOD 6) + MIN(gr.arr[((ORD(v18) + gp.z)) MOD 3], LAST(v19)))) MOD 997);
              END;
            ELSE
              FOR i175 := FIRST(INTEGER) + 3 TO FIRST(INTEGER) + 1 BY -1 DO
                T("t176", (i175 MOD 997));
                IF (996 + gs) > w168.b THEN RETURN (((gr2.arr[(MAX(ORD(w168.c), 7)) MOD 3] * 0) - (255 + ORD(gr2.c)))) MOD 997 END;
                gr2.arr := w168.arr;
              END;
            END;
          END;
          WITH w177 = 1 + (MIN((-2), w168.arr[(41) MOD 3])) MOD MIN(NUMBER(go^), NUMBER(v19)), w178 = (MAX(w168.b, w168.a)) MOD (NUMBER(go^) - w177 + 1), w179 = (5) MOD (NUMBER(v19) - w177 + 1) DO
            SUBARRAY(go^, w178, w177) := SUBARRAY(v19, w179, w177);
          END;
        | Color.Gray =>
          T("t180", 0);
          WITH w181 = gr2.b, w182 = gs DO
            TRY
              c183 := 0;
              REPEAT
                INC(c183);
                w181 := (ga[(gi1) MOD 5]) MOD 26 - 5;
                IF NOT (((gr.arr[((v20 MOD 4)) MOD 3] * 4)) MOD 3 = 0) THEN EXIT END;
                RAISE E;
              UNTIL c183 >= 2;
              IF (((w168.arr[(gp.x) MOD 3] DIV 5)) MOD 3 = 2) AND (((ORD(v18) DIV 5)) MOD 2 = 0) THEN
                gr := gr;
                RETURN (ga[((-100)) MOD 5]) MOD 997;
              END;
            FINALLY
              T("t191", 0);
              CASE ((MAX((-100), v20) + gr.arr[(MIN(v20, ORD(w168.c))) MOD 3])) MOD 7 OF
              | 1, 2 =>
