                T("t185", ((gr2.arr[(gi3) MOD 3] MOD 1) * 7));
              | 3 =>
                T("t186", 0);
                T("t187", ((ABS(4) MOD 8) - ((x - NUMBER(v19)) DIV 7)));
                gr2 := w168;
              | 5 =>
                T("t188", 0);
                INC(x);
              | 0 =>
                T("t189", 0);
              ELSE
                T("t190", 0);
              END;
            END;
          END;
        END;
        TRY
          v20 := ((MAX(198, x) - (gp.y + 4))) MOD 997;
        FINALLY
          T("t193", 0);
          T("t192", 2);
        END;
      END;
      gr2.c := VAL(((ORD(v18) - NUMBER(v19))) MOD 4, Color);
      LOCK m DO
        IF ((NUMBER(v19) - v20)) MOD 3 = 2 THEN RAISE F((v19[(LAST(gr2.arr)) MOD 5]) MOD 997) END;
        TRY
          T("t194", (((LAST(ga) * (-3)) DIV 3) MOD 7));
          IF NOT (((gi3 - ga[((gp.x - 5)) MOD 5])) MOD 2 = 0) THEN RAISE F(((ORD(v18) - LAST(v19))) MOD 997) END;
          CASE (((-2) + ORD(gr.c))) MOD 2 OF
