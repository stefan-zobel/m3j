            T("t197", gr.arr[(ABS(NUMBER(go^))) MOD 3]);
          END;
          IF ((127 + gr2.b)) MOD 2 = 0 THEN RAISE F((ORD(gc)) MOD 997) END;
        EXCEPT
        | F (e198) =>
          T("t199", e198);
          RETURN (e198) MOD 997;
        END;
      END;
      RETURN (MAX(1, go2[((100 * 6)) MOD NUMBER(go2^), (1) MOD NUMBER(go2[0])])) MOD 997;
    FINALLY
      Snap("P4>");
    END;
  END P4;

BEGIN
  gi0 := 0;
  gi1 := 42;
  gi2 := (-1);
  gi3 := 255;
  gs := 13;
  gc := Color.Blue;
  ga := Arr5{3, 42, 0, (-1), (-100)};
  gr := Rec{a := 2, b := 4, c := Color.Gray, arr := Arr3{2, (-100), 100}};
  gr2 := Rec{a := (-1), b := 19, c := Color.Blue, arr := Arr3{996, (-2), (-100)}};
  gp := Pk{x := 16, y := 0, c := Color.Green, z := 427};
  go := NEW(REF ARRAY OF INTEGER, 7);
  go[0] := 100;
  go[1] := 255;
  go[2] := 4;
  go[3] := 7;
  go[4] := (-1);
  go[5] := 248;
  go[6] := 1;
  go2 := NEW(REF ARRAY OF ARRAY OF INTEGER, 2, 1);
  go2[0, 0] := 255;
  go2[1, 0] := 42;
  m := NEW(MUTEX);
  fuel := 300;
  Snap("init");
  TRY
    T("t200", P0(gr2.arr, P4, ((5 - ORD(gr.c))) MOD 997, gr.a));
  EXCEPT
  | E =>
    T("t202", 0);
  | F (e201) =>
    T("t203", e201);
  END;
  TRY
    T("t204", P0(gr2.arr, P4, (MAX(10, gi3)) MOD 997, ((42 DIV 5)) MOD 997));
  EXCEPT
  | E =>
    T("t206", 0);
  | F (e205) =>
    T("t207", e205);
  END;
  TRY
    T("t208", P1(1, (MIN((-1), 4)) MOD 997, P4, gr)[0]);
  EXCEPT
  | E =>
    T("t210", 0);
  | F (e209) =>
    T("t211", e209);
  END;
  Snap("t216");
  TRY
    T("t212", P3(P4)[0]);
  EXCEPT
  | E =>
    T("t214", 0);
  | F (e213) =>
    T("t215", e213);
  END;
  TRY
    T("t217", P3(P4)[0]);
  EXCEPT
  | E =>
    T("t219", 0);
  | F (e218) =>
    T("t220", e218);
  END;
  Snap("t225");
  TRY
    T("t221", P4((((ORD(gr2.c) DIV 5) - (0 * 1))) MOD 997));
  EXCEPT
  | E =>
