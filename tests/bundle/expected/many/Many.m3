  E19,
  NIL (* E20 .. E20_0 *),
  E21,
  NIL
};

PROCEDURE GetElt (n: INTEGER): TEXT =
  <*FATAL Thread.Alerted, Wr.Failure *>
  VAR wr := TextWr.New ();
  BEGIN
    CASE n OF
    | 20 =>
        Wr.PutText (wr, E20);
        Wr.PutText (wr, E20_0);
    ELSE (*skip*)
    END;
    RETURN TextWr.ToText (wr);
  END GetElt;

