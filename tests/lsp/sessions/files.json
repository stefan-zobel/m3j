{
 "comment": "several open files: hover in one and then in the other (each compiled first), an interface, a file without a directory src above it (not checked), a file closed, the m3makefile saved (m3build runs again)",
 "steps": [
  {"send": {"method": "textDocument/didOpen",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Main.m3"}, "languageId": "modula3",
                                        "version": 1, "text": {"$text": "app/src/Main.m3"}}}}},
  {"send": {"method": "textDocument/didOpen",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.m3"}, "languageId": "modula3",
                                        "version": 1, "text": {"$text": "app/src/Util.m3"}}}}},
  {"send": {"id": 1, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Main.m3"}},
                       "position": {"$pos": ["app/src/Main.m3", "total := Util", 1, 0]}}}},
  {"send": {"id": 2, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.m3"}},
                       "position": {"$pos": ["app/src/Util.m3", "a + b", 1, 4]}}}},
  {"send": {"id": 3, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Main.m3"}},
                       "position": {"$pos": ["app/src/Main.m3", "Greeting, total", 1, 0]}}}},
  {"send": {"method": "textDocument/didOpen",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.i3"}, "languageId": "modula3",
                                        "version": 1, "text": {"$text": "app/src/Util.i3"}}}}},
  {"send": {"id": 4, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.i3"}},
                       "position": {"$pos": ["app/src/Util.i3", "Point = RECORD", 1, 0]}}}},
  {"send": {"id": 5, "method": "textDocument/definition",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.m3"}},
                       "position": {"$pos": ["app/src/Util.m3", "PROCEDURE Add", 1, 10]}}}},
  {"send": {"method": "textDocument/didOpen",
            "params": {"textDocument": {"uri": {"$uri": "loose/Loose.m3"}, "languageId": "modula3",
                                        "version": 1, "text": {"$text": "loose/Loose.m3"}}}},
   "wait": false},
  {"quiet": 4},
  {"send": {"id": 6, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "loose/Loose.m3"}},
                       "position": {"$pos": ["loose/Loose.m3", "INC (x)", 1, 5]}}}},
  {"send": {"method": "textDocument/didClose",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.m3"}}}}},
  {"send": {"id": 7, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Util.m3"}},
                       "position": {"$pos": ["app/src/Util.m3", "a + b", 1, 4]}}}},
  {"send": {"method": "textDocument/didSave",
            "params": {"textDocument": {"uri": {"$uri": "app/src/m3makefile"}}}}},
  {"send": {"id": 8, "method": "textDocument/hover",
            "params": {"textDocument": {"uri": {"$uri": "app/src/Main.m3"}},
                       "position": {"$pos": ["app/src/Main.m3", "Shapes.NewCircle", 1, 9]}}}}
 ]
}
