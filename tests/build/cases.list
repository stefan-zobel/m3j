# The cases of tools/build_test.py cases: NAME DIRECTORY COMMAND; ...
# (the commands are described in tools/build_test.py; <work> is the
# directory of the copy of the case)

prog     prog     m3build hello; run hello/JVM/hello; run hello/JVM/hello again; m3build hello; touch hello/src/Greet.m3; m3build hello; exists hello/JVM/WordTbl.i3; m3build hello -clean; absent hello/JVM/hello.jar; absent hello/JVM/WordTbl.i3; m3build hello -realclean; absent hello/JVM

lib      lib      m3build greet; m3build greet -ship; m3build greet -ship -root <work>/root; exists root/pkg/greet/JVM/.M3EXPORTS; exists root/pkg/greet/JVM/WordSeq.m3; exists root/pkg/greet/src/Greet.m3; exists root/pkg/greet/src/greet.tmpl; m3build user -root <work>/root; run user/JVM/user; m3build user -ship -root <work>/root; run root/bin/user; m3build user2; m3build user2 -override; run user2/JVM/user2

bundle   bundle   m3build res; run res/JVM/res; exists res/JVM/Res.i3

java     java     javac jbind/classes jbind/extra/tool/Extra.java; javac jbind/jarclasses jbind/java/tool/Greeter.java; jar jbind/lib/tool.jar jbind/jarclasses; m3build jbind; run jbind/JVM/jbind; m3build jbind; touch jbind/lib/tool.jar; m3build jbind; run jbind/JVM/jbind; m3build jbind -ship -root <work>/root; run root/bin/jbind; m3build jbind -clean; absent jbind/JVM/jbind.jar; m3build missing; absent missing/JVM/missing.jar

java-lib java    javac jlib/jarclasses jlib/java/tool/Hello.java; jar jlib/lib/hello.jar jlib/jarclasses; m3build jlib; exists jlib/JVM/hello.jar; m3build jlib -ship -root <work>/root; exists root/pkg/jlib/JVM/hello.jar; m3build juser -root <work>/root; run juser/JVM/juser; m3build juser -ship -root <work>/root; run root/bin/juser; m3build jlib2 -root <work>/root; m3build jlib2 -ship -root <work>/root; m3build juser2 -root <work>/root; run juser2/JVM/juser2; m3build jlibdir; absent jlibdir/JVM/.M3EXPORTS

tls      tls      m3build use; run use/JVM/use

http     http     m3build use; run use/JVM/use

httpform httpform m3build use; run use/JVM/use

xml      xml      m3build use; run use/JVM/use

json     json     m3build use; run use/JVM/use

zip      zip      m3build use; run use/JVM/use

encoding encoding m3build use; run use/JVM/use

crypto   crypto   m3build use; run use/JVM/use

netobj   netobj   m3build nob; exists nob/JVM/Test_T_v1.m3; exists nob/JVM/Test_U_v2.m3; pair nob/JVM/netobj

errors   errors   m3build bad; absent bad/JVM/bad.jar; m3build noimport; m3build csrc; absent csrc/JVM/csrc.jar; m3build unsafe; absent unsafe/JVM/unsafe.jar
