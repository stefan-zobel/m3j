#!/bin/sh
# Copyright (c) 2026 the m3j authors.
# SPDX-License-Identifier: MIT
#
# The compiler of m3j, in bin of a release: m3j [OPTION]... FILE...
# (docs/USING.md). Runs java of $JAVA_HOME if it is set, else java from the
# PATH (JDK 25 or later).

dir=$(cd "$(dirname "$0")/.." && pwd)
if [ -n "$JAVA_HOME" ]; then java="$JAVA_HOME/bin/java"; else java=java; fi
exec "$java" -cp "$dir/m3j.jar" m3j.jvm.Compile "$@"
