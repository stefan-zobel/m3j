# Every file is checked out with the bytes of the repository, whatever
# core.autocrlf says: tests read their data and compare outputs byte for byte.
* -text
# Scripts keep LF line endings on every system, so that their first line
# (#!/bin/sh, #!/usr/bin/env python3) works on Linux and macOS.
*.py text eol=lf
*.sh text eol=lf
# the start scripts of a release (tools/dist), which have no extension
tools/dist/m3j text eol=lf
tools/dist/m3build text eol=lf
# cmd.exe needs CR LF
*.cmd text eol=crlf
# workflows of GitHub Actions
*.yml text eol=lf
