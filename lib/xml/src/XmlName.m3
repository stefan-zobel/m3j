PROCEDURE In (READONLY a: ARRAY OF INTEGER; c: INTEGER): BOOLEAN =
  VAR lo := 0; hi := NUMBER (a) DIV 2 - 1; m: INTEGER;
  BEGIN
    WHILE lo <= hi DO
      m := (lo + hi) DIV 2;
      IF c < a[2 * m] THEN
        hi := m - 1;
      ELSIF c > a[2 * m + 1] THEN
        lo := m + 1;
      ELSE
        RETURN TRUE;
      END;
    END;
    RETURN FALSE;
  END In;

PROCEDURE IsStart (ch: WIDECHAR): BOOLEAN =
  VAR c := ORD (ch);
  BEGIN
    IF c < 16_80 THEN
      RETURN c >= ORD ('a') AND c <= ORD ('z') OR c >= ORD ('A') AND c <= ORD ('Z')
               OR c = ORD ('_');
    END;
    RETURN In (Starts, c);
  END IsStart;

PROCEDURE IsName (ch: WIDECHAR): BOOLEAN =
  VAR c := ORD (ch);
  BEGIN
    IF c < 16_80 THEN
      RETURN c >= ORD ('a') AND c <= ORD ('z') OR c >= ORD ('A') AND c <= ORD ('Z')
               OR c >= ORD ('0') AND c <= ORD ('9')
               OR c = ORD ('_') OR c = ORD ('-') OR c = ORD ('.');
    END;
    RETURN In (Names, c);
  END IsName;

PROCEDURE Valid (t: TEXT): BOOLEAN =
  VAR n := Text.Length (t);
  BEGIN
    IF n = 0 OR NOT IsStart (Text.GetWideChar (t, 0)) THEN RETURN FALSE END;
    FOR i := 1 TO n - 1 DO
      IF NOT IsName (Text.GetWideChar (t, i)) THEN RETURN FALSE END;
    END;
    RETURN TRUE;
  END Valid;

BEGIN
END XmlName.
