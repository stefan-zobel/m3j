% exports of json: a pull parser and a writer for JSON, in plain Modula-3
_define_lib("json")
import_version("m3core", "JVM")
import_version("libm3", "JVM")
_map_add_interface("JsonReader.i3", "json", "src", "")
_map_add_module("JsonReader.m3", "json", "src", "hidden")
_map_add_interface("JsonWriter.i3", "json", "src", "")
_map_add_module("JsonWriter.m3", "json", "src", "hidden")
